<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.drawing.springboot.dao.IFloorplanDAO">
 	<insert id="insertDAO" parameterType="com.drawing.springboot.dto.FloorplanDTO">
        <selectKey keyProperty="f_code" resultType="String" order="BEFORE">
            SELECT 'FP' || LPAD(SEQ_INTERIOR.NEXTVAL, 5, '0') FROM DUAL
        </selectKey>
        INSERT INTO FLOORPLAN (F_CODE,M_CODE,F_TEMPLATE,JSON_DATA,F_IMG,F_DATE)
         VALUES (#{f_code},#{m_code, jdbcType=VARCHAR},#{f_template},#{json_data},#{f_img},SYSDATE)
    </insert>
    
    <delete id="deleteDAO">
    	DELETE FROM FLOORPLAN
    	 WHERE F_CODE = #{f_code}
    </delete>
    
    <select id="selectDAOByFCode" resultType="com.drawing.springboot.dto.FloorplanDTO">
        SELECT * FROM FLOORPLAN WHERE F_CODE = #{f_code}
    </select>
    
    <select id="selectDAOByMCode" resultType="com.drawing.springboot.dto.FloorplanDTO">
        SELECT * FROM FLOORPLAN WHERE M_CODE = #{m_code} ORDER BY F_DATE DESC
    </select> 
    
</mapper>